# =====================================================
# AI 智能客服 - 环境变量配置
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填写必填项（标记了 REQUIRED 的变量）
#   3. 执行 docker-compose up -d 启动
# =====================================================

# ==================== [REQUIRED] 阿里云百炼 API Key ====================
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ==================== [REQUIRED] JWT 密钥（最少32位字符）====================
JWT_SECRET_KEY=AicsJwtSecret2026MinLength32Chars!

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=Aics@2026!

# ==================== Redis 配置（无密码留空）====================
REDIS_PASSWORD=

# ==================== MinIO 对象存储 ====================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==================== 前端 API 地址 ====================
# Docker 部署时走 Nginx 反向代理，保持 /api 即可
# 本地开发时改为：http://localhost:8080
VITE_API_BASE_URL=/api
