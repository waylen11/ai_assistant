# =====================================================
# AI 智能客服系统 - .gitignore
# =====================================================

# ==================== 敏感配置（不入库）====================
.env
*.env.local
*.env.production

# ==================== Java / Maven ====================
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
*/src/main/resources/config.yml

# ==================== Node.js ====================
node_modules/
dist/
.cache/
.parcel-cache/
*.local

# ==================== IDE ====================
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==================== 系统文件 ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== 日志 ====================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== 运行时文件 ====================
*.pid
*.seed
*.pid.lock

# ==================== TypeScript 自动生成 ====================
src/auto-imports.d.ts
src/components.d.ts

# ==================== WorkBuddy 内部目录 ====================
.workbuddy/
